# Supabase (get these from your Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base domain used for tenant subdomain routing in production
# e.g. if this is "yourplatform.com" then org "acme" resolves to acme.yourplatform.com
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Resend (email digests / broadcasts) - added in Phase 2
RESEND_API_KEY=
